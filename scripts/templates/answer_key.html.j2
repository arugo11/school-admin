<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{{ manifest.test_id }} Answer Key</title>
    <link rel="stylesheet" href="{{ katex.katex_css }}" />
    <script defer src="{{ katex.katex_js }}"></script>
    <script defer src="{{ katex.katex_autorender_js }}"></script>
    <style>
      @page { size: A4; margin: 12mm; }
      body {
        font-family: 'Noto Sans CJK JP', 'Hiragino Sans', 'Yu Gothic', sans-serif;
        color: #1f1f1f;
        margin: 0;
        background: #f4f4f4;
      }
      h1 { font-family: 'BIZ UDPMincho', serif; margin-bottom: 0; }
      .meta { color: #555; margin-bottom: 6mm; }
      table { width: 100%; border-collapse: collapse; font-size: 12px; }
      th, td { border: 1px solid #bcbcbc; padding: 3mm; vertical-align: top; background: #fff; }
      th { background: #e7e7e7; text-align: left; }
      .katex-display { margin: 0.2em 0; }
    </style>
  </head>
  <body>
    <h1>Answer Key</h1>
    <div class="meta">test_id: {{ manifest.test_id }} / source: {{ manifest.source_dataset }} / seed: {{ manifest.seed }}</div>
    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>catalog_problem_no</th>
          <th>subject</th>
          <th>level</th>
          <th>answer</th>
          <th>source_unique_id</th>
        </tr>
      </thead>
      <tbody>
        {% for problem in manifest.problems %}
        <tr>
          <td>Q{{ problem.display_no }}</td>
          <td>{{ problem.catalog_problem_no }}</td>
          <td>{{ problem.subject }}</td>
          <td>{{ problem.level }}</td>
          <td>{{ problem.answer }}</td>
          <td>{{ problem.source_unique_id }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <script>
      window.__renderDone = false;
      document.addEventListener('DOMContentLoaded', () => {
        renderMathInElement(document.body, {
          delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false},
            {left: '\\(', right: '\\)', display: false},
            {left: '\\[', right: '\\]', display: true}
          ],
          throwOnError: false
        });
        window.__renderDone = true;
      });
    </script>
  </body>
</html>
